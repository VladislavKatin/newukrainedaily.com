/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.xml
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The *.pages.dev addresses are copies of www.newukrainedaily.com: keep them out
# of search results so Google indexes only the real domain.
https://newukrainedaily.pages.dev/*
  X-Robots-Tag: noindex

https://:version.newukrainedaily.pages.dev/*
  X-Robots-Tag: noindex
